# Local PostgreSQL and API
DATABASE_URL=postgresql://brightledger:brightledger-local@localhost:5432/brightledger
DATABASE_SSL=false
DB_POOL_MAX=10
API_PORT=4000
POSTGRES_PASSWORD=brightledger-local

# Frontend origin and wallet-signing domain
API_ORIGIN=http://localhost:5173
AUTH_URI=http://localhost:5173
AUTH_DOMAIN=Bright Ledger
# Set VITE_API_BASE_URL separately in frontend/.env.local or the Vercel project environment.

# EVM network used by the backend
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
# Optional backend RPC fallback for Base Sepolia (chain ID 84532).
BASE_SEPOLIA_ALCHEMY_API_KEY=

# Optional operator-managed wallet allowlists (comma-separated addresses)
ADMIN_WALLET_ADDRESSES=
VERIFIER_WALLET_ADDRESSES=
SPACE_OWNER_WALLET_ADDRESSES=

# Optional AI and electricity-price reference integrations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
EIA_API_KEY=

# Optional Alchemy RPC demo
ALCHEMY_API_KEY=

# Optional testnet contract deployment settings.
# Keep deployment credentials in blockchain/.env when possible.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETH_USD_FEED_ADDRESS=

# Never put API keys or private keys in VITE_* variables or commit them.
